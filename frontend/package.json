{
  "name": "dentasoft",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/runtime-config.mjs --dev && ng serve",
    "build": "node scripts/runtime-config.mjs && ng build && node scripts/csp.mjs",
    "watch": "node scripts/runtime-config.mjs --dev && ng build --watch --configuration development",
    "test": "node --test \"scripts/**/*.test.mjs\" && ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:gen": "node scripts/api-gen.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
