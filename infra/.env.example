# Local infrastructure settings. Copy to `.env` (ignored by Git) and change the values:
#   Copy-Item .env.example .env
# Every value below is a placeholder. Never put a real credential in this file.

# --- Image versions (pinned; update them on purpose, never use `latest`) ---
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg18-trixie
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
REDIS_IMAGE=redis:8.8.4-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.55
AWS_CLI_IMAGE=amazon/aws-cli:2.42.1
MAILPIT_IMAGE=axllent/mailpit:v1.34.0
CLAMAV_IMAGE=clamav/clamav:1.5.5

# --- PostgreSQL ---
# Superuser of the container. Only for the init script and manual administration.
POSTGRES_PASSWORD=change-me-postgres-superuser
# Owner of the `dentasoft` database (Flyway migrations).
DENTASOFT_DB_OWNER_PASSWORD=change-me-db-owner
# Application role (NOBYPASSRLS, owns nothing).
DENTASOFT_DB_APP_PASSWORD=change-me-db-app
DENTASOFT_DB_PLATFORM_PASSWORD=change-me-db-platform
# Keycloak's own database role.
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# --- Keycloak (temporary admin of the master realm) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin

# --- Redis ---
DENTASOFT_REDIS_PASSWORD=change-me-redis

# --- S3-compatible storage (SeaweedFS in local) ---
DENTASOFT_S3_ACCESS_KEY=change-me-s3-access-key
DENTASOFT_S3_SECRET_KEY=change-me-s3-secret-key
DENTASOFT_S3_BUCKET=dentasoft-docs
DENTASOFT_S3_REGION=us-east-1

# --- Backend: rate limiting ---
# Secret key for the HMAC of client IPs in Redis. Optional in the `local` profile (it has a
# development default); required in every other environment. Generate it with:
#   openssl rand -base64 32
DENTASOFT_RATE_LIMIT_KEY=change-me-rate-limit-hmac-key
# Proxies allowed to set X-Forwarded-For / CF-Connecting-IP (IPs or CIDR, comma separated).
# Empty in local: the connection address is used.
DENTASOFT_TRUSTED_PROXIES=
