{
  "realm": "dentasoft",
  "displayName": "Dentasoft",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "organizationsEnabled": true,
  "adminPermissionsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es"
  ],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionIdleTimeout": 1800,
  "offlineSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "eventsListeners": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "adminEventsExpiration": "7776000"
  },
  "smtpServer": {
    "host": "${DENTASOFT_KC_SMTP_HOST}",
    "port": "${DENTASOFT_KC_SMTP_PORT}",
    "from": "${DENTASOFT_MAIL_FROM}",
    "fromDisplayName": "Dentasoft",
    "auth": "${DENTASOFT_KC_SMTP_AUTH}",
    "user": "${DENTASOFT_KC_SMTP_USER}",
    "password": "${DENTASOFT_KC_SMTP_PASSWORD}",
    "starttls": "${DENTASOFT_KC_SMTP_STARTTLS}",
    "ssl": "${DENTASOFT_KC_SMTP_SSL}"
  },
  "roles": {
    "realm": [
      {
        "name": "PLATFORM_ADMIN",
        "description": "Creates and suspends clinics. Never sees clinical data (ADR 0011)."
      }
    ]
  },
  "groups": [
    {
      "id": "5b597034-44d8-49d0-a878-5d4fe5a6efbb",
      "name": "clinic-users",
      "path": "/clinic-users",
      "description": "Every clinic user. Platform administrators are never members: dentasoft-backend manages only the members of this group. Its id is fixed because the backend-manages-clinic-users permission names it."
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "acr",
    "profile",
    "email",
    "roles",
    "web-origins"
